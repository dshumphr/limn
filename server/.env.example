# Copy to .env (same dir) if you want to override; defaults are smart:
# - OPENROUTER_API_KEY falls back to the key stored in ~/.omp/agent/agent.db
# - FAL_KEY falls back to the ambient environment (frameit needs it)
# OPENROUTER_API_KEY=sk-or-v1-...
# FAL_KEY=
# STT_MODEL=openai/whisper-large-v3
# PORT=8000
